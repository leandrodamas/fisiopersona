# AUTOMATICO: npm run db:migrate aplica tudo em sql/migrations.manifest.json (CNS, parceira, curso, RLS, dias/estagiarios text[]).
# Onde copiar: Supabase → Project Settings → Database → Connection string → URI (Postgres + senha).
# Guarde como ficheiro .env nesta pasta. Nunca commite credenciais reais.
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
